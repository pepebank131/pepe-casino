# Database
DATABASE_URL=postgresql://user:pass@host:5432/db
# Only if your host uses a self-signed cert (otherwise leave unset):
# PG_SSL_REJECT_UNAUTHORIZED=0

# Telegram bot
BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=   # optional alias

# Admin allowlist (comma-separated Telegram user IDs) — NEVER commit real IDs to git
ADMIN_TELEGRAM_IDS=1256452126,6479535975,7617669253
# ADMIN_TELEGRAM_ID=   # single-admin fallback

# Protect /api/telegram/set-webhook and webhook-info
ADMIN_API_SECRET=change-me-long-random
# WEBHOOK_SETUP_SECRET=  # optional alias

# Telegram webhook secret_token (REQUIRED in production)
TELEGRAM_WEBHOOK_SECRET=change-me-long-random

# Vercel cron / rocket tick (Authorization: Bearer …)
CRON_SECRET=change-me-long-random

# Optional overrides
# TREASURY_WALLET=UQAfazCyjGjugOf73_LrxUuLvxSmExM_8loArhgATwKXU6yA
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook

# Dev only — never enable in production
# ALLOW_UNVERIFIED_TON_DEPOSITS=1
